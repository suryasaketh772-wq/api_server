<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Status Bar: Title & Last Updated Timestamp -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE BULLION"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updating..."
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Main Pricing Grid: Gold Spot and Silver Spot Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Gold Pricing Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOLD SPOT"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gold_spot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$--"
                android:textColor="#D4AF37"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/gold_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H: $--"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/gold_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L: $--"
                android:textColor="#FF3B30"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Vertical Separator Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2A2A2A"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp" />

        <!-- Silver Pricing Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SILVER SPOT"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_spot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$--"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/silver_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H: $--"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/silver_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L: $--"
                android:textColor="#FF3B30"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Status Bar: USD/INR currency exchange rates -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:paddingTop="8dp"
        android:borderTop="1dp"
        android:background="#1E1E1E"
        android:padding="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/usd_inr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USD/INR: --"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
