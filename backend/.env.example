# Server Execution Mode (development / production)
ENVIRONMENT=production
APP_NAME="Bullion Realtime Server"

# DPGold API Credentials
# IMPORTANT: If DPGOLD_API_URL or DPGOLD_API_KEY are empty or left out,
# the server automatically switches to MOCK MODE.
# In Mock Mode, realistic pricing is simulated and broadcast every 2s.
DPGOLD_API_URL=https://statewisebcast.dpgold.in:7768/VOTSBroadcastStreaming/Services/xml/GetLiveRateByTemplateID/dpgold
DPGOLD_API_KEY=

# Tuning Constants (Optional - defaults to 2 and 30)
POLL_INTERVAL_SECS=2
WS_HEARTBEAT_INTERVAL_SECS=30

# CORS Allowed Origins
# Specify comma-separated domains, or "*" to allow all
ALLOWED_ORIGINS="*"
